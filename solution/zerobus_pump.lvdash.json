{
  "datasets": [
    {
      "name": "ds_faceplate",
      "displayName": "Pump faceplate (silver)",
      "queryLines": [
        "SELECT\n",
        "  equipment_id,\n",
        "  round(max(value) FILTER (WHERE tag_name = 'Vibration'), 2)         AS vibration_mm_s,\n",
        "  round(max(value) FILTER (WHERE tag_name = 'BearingTemp'), 1)       AS bearing_temp_c,\n",
        "  round(max(value) FILTER (WHERE tag_name = 'FlowRate'), 1)          AS flow_m3h,\n",
        "  CASE\n",
        "    WHEN max(value) FILTER (WHERE tag_name = 'Running') = 0 THEN 'STOPPED'\n",
        "    WHEN max(value) FILTER (WHERE tag_name = 'Vibration') > 7.1\n",
        "      OR max(value) FILTER (WHERE tag_name = 'BearingTemp') > 75 THEN 'ALARM'\n",
        "    WHEN max(value) FILTER (WHERE tag_name = 'Vibration') > 4.5\n",
        "      OR max(value) FILTER (WHERE tag_name = 'BearingTemp') > 65 THEN 'WARNING'\n",
        "    ELSE 'OK'\n",
        "  END AS health,\n",
        "  max(event_ts) AS last_reading,\n",
        "  round((unix_millis(current_timestamp()) - unix_millis(max(event_ts))) / 1000, 1) AS silver_lag_s\n",
        "FROM pump_tags_current\n",
        "GROUP BY equipment_id\n"
      ]
    },
    {
      "name": "ds_ingest",
      "displayName": "Ingest volume (bronze)",
      "queryLines": [
        "SELECT count(*) AS readings_5m\n",
        "FROM pump_tags_bronze\n",
        "WHERE event_ts >= timestampadd(MINUTE, -5, current_timestamp())\n"
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "10-second trends (bronze)",
      "queryLines": [
        "SELECT\n",
        "  timestamp_seconds(floor(unix_timestamp(event_ts) / 10) * 10) AS ts,\n",
        "  equipment_id,\n",
        "  avg(value) FILTER (WHERE tag_name = 'Vibration')         AS vibration_mm_s,\n",
        "  avg(value) FILTER (WHERE tag_name = 'BearingTemp')       AS bearing_temp_c,\n",
        "  avg(value) FILTER (WHERE tag_name = 'FlowRate')          AS flow_m3h,\n",
        "  avg(value) FILTER (WHERE tag_name = 'DischargePressure') AS discharge_bar\n",
        "FROM pump_tags_bronze\n",
        "WHERE event_ts >= timestampadd(MINUTE, -30, current_timestamp())\n",
        "GROUP BY 1, 2\n"
      ]
    },
    {
      "name": "ds_current",
      "displayName": "Current state per tag (silver)",
      "queryLines": [
        "SELECT\n",
        "  equipment_id,\n",
        "  tag_name,\n",
        "  round(value, 2) AS value,\n",
        "  unit,\n",
        "  quality,\n",
        "  event_ts,\n",
        "  round((unix_millis(bronze_committed_at) - unix_millis(event_ts)) / 1000, 1) AS ingest_latency_s\n",
        "FROM pump_tags_current\n",
        "ORDER BY equipment_id, tag_name\n"
      ]
    }
  ],
